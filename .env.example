# Copy this file to .env and fill in the values.

# Which model provider to use: gemini or anthropic
LLM_PROVIDER=gemini

# Model id for that provider. Copy the exact id from the provider's model list:
#   Gemini:    https://ai.google.dev/gemini-api/docs/models
#   Anthropic: https://docs.claude.com
LLM_MODEL=

# API key for the provider you chose (only one is needed).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Password for the /admin page. Pick any long random string.
ADMIN_TOKEN=

# --- Optional settings (defaults shown) ---
# MAX_ANSWER_TOKENS=1500
# TOP_K=5
# MAX_DISTANCE=0.8
# RATE_LIMIT_PER_MINUTE=10
# REFUSAL_MESSAGE=That isn't in your documents.

# Prices in USD per million tokens, used only for the cost column in the log.
# PRICE_INPUT_PER_MTOK=0
# PRICE_OUTPUT_PER_MTOK=0
